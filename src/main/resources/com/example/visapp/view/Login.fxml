<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ComboBox?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<AnchorPane prefHeight="720.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.visapp.controller.LoginController"
            style="-fx-background-color: linear-gradient(to bottom right, #0f172a, #1e293b);">

    <!-- LEFT SIDE -->
    <VBox layoutX="80.0" layoutY="140.0" spacing="25">

        <Label text="Vehicle Identification System"
               textFill="WHITE">
            <font>
                <Font size="34"/>
            </font>
        </Label>

        <Label text="Secure vehicle tracking and management platform"
               style="-fx-text-fill: #cbd5e1; -fx-font-size: 16px;" />

        <VBox spacing="12">

            <HBox spacing="10">
                <Label text="✔"
                       style="-fx-text-fill: #22c55e; -fx-font-size: 16px;"/>

                <Label text="Workshop management"
                       style="-fx-text-fill: white; -fx-font-size: 15px;"/>
            </HBox>

            <HBox spacing="10">
                <Label text="✔"
                       style="-fx-text-fill: #22c55e; -fx-font-size: 16px;"/>

                <Label text="Insurance tracking"
                       style="-fx-text-fill: white; -fx-font-size: 15px;"/>
            </HBox>

            <HBox spacing="10">
                <Label text="✔"
                       style="-fx-text-fill: #22c55e; -fx-font-size: 16px;"/>

                <Label text="Police verification system"
                       style="-fx-text-fill: white; -fx-font-size: 15px;"/>
            </HBox>

            <HBox spacing="10">
                <Label text="✔"
                       style="-fx-text-fill: #22c55e; -fx-font-size: 16px;"/>

                <Label text="Customer service support"
                       style="-fx-text-fill: white; -fx-font-size: 15px;"/>
            </HBox>

        </VBox>

    </VBox>

    <!-- LOGIN CARD -->
    <VBox layoutX="760.0"
          layoutY="50.0"
          prefHeight="640.0"
          prefWidth="340.0"
          spacing="15"
          alignment="CENTER"
          style="-fx-background-color: white;
                 -fx-background-radius: 20;
                 -fx-padding: 35;">

        <effect>
            <DropShadow color="#00000055"
                        height="30"
                        radius="20"
                        spread="0.2"
                        width="30"/>
        </effect>

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="8" >

            <Label text="Welcome Back"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #0f172a;" />

            <Label text="Login to continue"
                   style="-fx-font-size: 14px;
                          -fx-text-fill: #64748b;" />

        </VBox>

        <!-- USERNAME -->
        <VBox spacing="8">

            <Label text="Username"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #334155;" />

            <TextField fx:id="usernameField"
                       prefHeight="45"
                       promptText="Enter username"
                       style="-fx-background-radius: 10;
                              -fx-border-radius: 10;
                              -fx-border-color: #cbd5e1;
                              -fx-background-color: #f8fafc;
                              -fx-font-size: 14px;" />

        </VBox>

        <!-- PASSWORD -->
        <VBox spacing="8">

            <Label text="Password"
                   style="-fx-font-size: 14px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #334155;" />

            <PasswordField fx:id="passwordField"
                           prefHeight="45"
                           promptText="Enter password"
                           style="-fx-background-radius: 10;
                                  -fx-border-radius: 10;
                                  -fx-border-color: #cbd5e1;
                                  -fx-background-color: #f8fafc;
                                  -fx-font-size: 14px;" />

        </VBox>
        <ComboBox fx:id="cmbDemoUsers"
                  promptText="Select Demo User"
                  prefWidth="300"
                  prefHeight="40"/>

        <!-- LOGIN BUTTON -->
        <Button fx:id="loginButton"
                text="Login"
                onAction="#handleLogin"
                prefWidth="270"
                prefHeight="48"
                style="-fx-background-color: green;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 12;
                       -fx-cursor: hand;">

            <effect>
                <DropShadow color="#2563eb88"
                            radius="12"
                            spread="0.3"/>
            </effect>

        </Button>
        <Button fx:id="registerButton"
                text="Register"
                onAction="#openRegister"
                prefWidth="270"
                prefHeight="48"
                style="-fx-background-color: blue;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 12;
                       -fx-cursor: hand;"/>

        <!-- FOOTER -->
        <Label text="Vehicle Identification System © 2026"
               style="-fx-text-fill: #94a3b8;
                      -fx-font-size: 12px;" />

        <padding>
            <Insets top="10"/>
        </padding>

        <ProgressBar fx:id="loginProgressBar"
                     prefWidth="250"
                     progress="0"/>

        <ProgressIndicator fx:id="loginIndicator"
                           progress="0"
                           prefHeight="40"
                           prefWidth="40"/>

    </VBox>

</AnchorPane>