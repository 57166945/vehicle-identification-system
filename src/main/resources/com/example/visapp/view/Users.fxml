<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0"
            prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.visapp.controller.UsersController"
            style="-fx-background-color: #f1f5f9;">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="15"
              alignment="CENTER_LEFT"
              style="-fx-background-color: white;
                     -fx-padding: 15 20 15 20;">

            <Label text="Users Management"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #0f172a;" />

            <Region HBox.hgrow="ALWAYS" />

            <TextField fx:id="searchField"
                       promptText="Search username..."
                       prefWidth="220"
                       style="-fx-background-radius: 10;
                              -fx-border-radius: 10;" />

            <Button text="Search"
                    onAction="#searchUsers"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;" />

            <Button text="Refresh"
                    onAction="#refreshUsers"
                    style="-fx-background-color: #16a34a;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;" />

            <Button text="Dashboard"
                    onAction="#goDashboard"
                    style="-fx-background-color: #475569;
                           -fx-text-fill: white;
                           -fx-background-radius: 10;" />
        </HBox>
    </top>

    <!-- LEFT FORM -->
    <left>

        <VBox prefWidth="350"
              spacing="15"
              style="-fx-background-color: #0f172a;
                     -fx-padding: 25;">

            <effect>
                <DropShadow color="#00000015"
                            radius="15"/>
            </effect>

            <Label text="Manage User"
                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;" />

            <Label text="Username"
                   style="-fx-text-fill: white;-fx-font-size: 12pt; -fx-font-weight: bold;"/>
            <TextField fx:id="usernameField"
                       promptText="Enter username"/>

            <Label text="Password"
                   style="-fx-text-fill: white;-fx-font-size: 12pt; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter password"/>

            <Label text="Role"
                   style="-fx-text-fill: white;-fx-font-size: 12pt; -fx-font-weight: bold;"/>
            <ComboBox fx:id="roleComboBox"
                      prefWidth="250"/>
            <VBox/>

            <Separator/>

        <HBox spacing="10">
            <Button text="Add User"
                    onAction="#addUser"
                    style="-fx-background-color: green;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            <Button text="Update User"
                    onAction="#updateUser"
                    style="-fx-background-color: blue;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />

            <Button text="Delete User"
                    onAction="#deleteUser"
                    style="-fx-background-color: red;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />

            <Button text="Clear Form"
                    onAction="#clearForm"
                    style="-fx-background-color: black;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;"/>

            </HBox>

        </VBox>

    </left>

    <!-- CENTER TABLE -->
    <center>
        <VBox spacing="15"
              style="-fx-padding: 20;">

            <TableView fx:id="usersTable"
                       prefHeight="600">

                <columns>
                    <TableColumn fx:id="colUserId"
                                 text="ID"
                                 prefWidth="80"/>

                    <TableColumn fx:id="colUsername"
                                 text="Username"
                                 prefWidth="180"/>

                    <TableColumn fx:id="colPassword"
                                 text="Password"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colRole"
                                 text="Role"
                                 prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>